# Private Master Password for Stage 1 Entry validation
PRIVATE_MASTER_PASSWORD=your_private_master_password_here

# HMAC SHA-256 Secret for signing session tokens and cookies
AUTH_SESSION_SECRET=your_secure_random_hmac_secret_here

# Optional: Supabase Database and Storage configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
